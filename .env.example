# ---------------------------------------------------------------------------
# Natsu Portfolio — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4000

# --- Database ---------------------------------------------------------------
# Local (docker compose): postgres://natsu:natsu@localhost:5432/natsu
# Managed (Railway/Render/Neon/Supabase): use the provided connection string.
DATABASE_URL=postgresql://natsu:natsu@localhost:5432/natsu?schema=public

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=natsu_session

# Seeded admin account (used by `npm run db:seed`).
# Change these before running the seed in any non-local environment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Natsu

# --- Redis (optional — used for rate-limit / caching when present) ----------
REDIS_URL=redis://localhost:6379

# --- Image storage (optional) -----------------------------------------------
# If Cloudinary is not configured the API falls back to local disk storage
# under apps/api/uploads and serves files from /uploads.
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=natsu-portfolio

# --- Email (optional) -------------------------------------------------------
# If neither provider is configured, contact messages are still persisted and
# the API simply skips the notification email.
EMAIL_FROM="Natsu Portfolio <no-reply@example.com>"
CONTACT_EMAIL=hello@example.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=60
THROTTLE_CONTACT_LIMIT=5
THROTTLE_LOGIN_LIMIT=8

# --- Frontend (Vite) --------------------------------------------------------
# Exposed to the browser. Leave empty to use same-origin / Vite dev proxy.
VITE_API_URL=http://localhost:4000
VITE_SITE_URL=http://localhost:5173
